<div class="staff_short block{{ class }}">

    {% if singleSRC|default %}
        {% set floatClass = floatClass|default ~ ' staff_short__image' %}
        {{ include('@Contao/image.html.twig') }}
    {% endif %}

    <h2 class="staff_short__name">{{ name_prefix|default }} {{ forename }} {{ surname }}{{ name_appendix|default }}</h2>

    {% if position|default %}
        <p class="staff_short__position">{{ position }}</p>
    {% endif %}

    {% if department|default %}
        <p class="staff_short__department">{{ department|join(', ') }}</p>
    {% endif %}

    {% if quote|default %}
        <div class="staff_short__quote">{{ quote }}</div>
    {% endif %}

    <div class="staff_short__contact">
        {% if phone|default %}
            <a class="staff_short__contact-link staff_short__phone" href="tel:{{ phone }}">{{ phone }}</a>
        {% endif %}

        {% if mobile|default %}
            <a class="staff_short__contact-link staff_short__mobile" href="tel:{{ mobile }}">{{ mobile }}</a>
        {% endif %}

        {% if email|default %}
            <a class="staff_short__contact-link staff_short__email" href="mailto:{{ insert_tag('email_url::' ~ email) }}" title="{{ forename }} {{ surname }} eine E-Mail schreiben">{{ email }}</a>
        {% endif %}
    </div>

    {% if link|default %}
        <a class="staff_short__link" href="{{ link }}" title="Mehr &uuml;ber die Person erfahren">Mehr zur Person</a>
    {% endif %}
</div>
